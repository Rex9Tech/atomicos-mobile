# ==============================================================================
# AtomicOS Mobile Environment Configuration Example
# Copy to .env.dev, .env.uat, or .env.prod based on target deployment tier
# ==============================================================================

# Active environment file name loaded via AppConfig (e.g. .env.dev, .env.uat, .env.prod)
APP_ENV=.env.dev

# Public app branding & metadata
APP_NAME="Atomic"
APP_VERSION=1.0.0

# Backend API Base URL (Do NOT include trailing slash)
#   - Local Dev: http://10.0.2.2:3000 (Android Emulator) or http://localhost:3000 (iOS Simulator)
#   - Prod: https://atomicos-core.khantsithu.tech
API_BASE_URL=https://atomicos-core.khantsithu.tech

# Authentication (Google Sign-In Web / Server Client ID for backend token exchange)
GOOGLE_SERVER_CLIENT_ID=changeme_google_server_client_id.apps.googleusercontent.com
GOOGLE_SERVER_CLIENT_SECRET=changeme_google_server_client_secret

# Push Notifications (OneSignal App ID)
ONE_SIGNAL_APP_ID=changeme_onesignal_app_id
ONESIGNAL_DISABLE_LOCATION=true

# Media offline encryption key for download features (32 bytes)
MEDIA_OFFLINE_ENCRYPTION_KEY=changeme_media_offline_encryption_key_32_bytes

# Native Application Identifiers
ANDROID_APP_ID=com.rex9.uat.atomic
IOS_APP_ID=com.rex9.uat.atomic
